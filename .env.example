# ------------------------------------------------------------------------------
# X Personas - Environment Variables Example
# Copy this file to `.env` and fill in the values for your setup.
# ------------------------------------------------------------------------------

# LLM Configuration (OpenAI-compatible API)
# Used for text-only tasks (original post generation, etc.)
OPENAI_API_KEY=your_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# VLM Configuration (Vision Language Model — optional)
# If VLM_MODEL is not set, VLM features (multimodal image analysis) are disabled.
# Falls back to OPENAI_API_KEY / OPENAI_BASE_URL if VLM-specific vars are not set.
# VLM_MODEL=gpt-4o
# VLM_API_KEY=
# VLM_BASE_URL=
