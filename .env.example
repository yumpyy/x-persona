# ------------------------------------------------------------------------------
# X Personas - Environment Variables Example
# Copy this file to `.env` and fill in the values for your setup.
# ------------------------------------------------------------------------------

# Active default persona profile (optional, defaults to persona-struct.md)
# DEFAULT_PERSONA=persona-struct.md

# LLM Providers Configuration
# You must provide the credentials for at least one configured provider below.

# 1. DashScope (DeepSeek via Alibaba Cloud - OpenAI compatible)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=qwen-vl-max
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 2. OpenAI
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# 3. Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
