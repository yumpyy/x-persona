/* ── X-Personas TUI — Catppuccin Mocha ── */

Screen {
    background: #1e1e2e;
}

/* ===== HEADER ===== */
#header {
    dock: top;
    height: 1;
    background: #313244;
    color: #cdd6f4;
}

/* ===== FOOTER ===== */
#footer {
    dock: bottom;
    height: 1;
    background: #181825;
    color: #a6adc8;
}

#footer > Static {
    padding: 0 1;
}

#compose-prompt-input {
    height: 3;
    background: #181825;
    border: none;
    color: #cdd6f4;
}

/* ===== ROOT LAYOUT — sidebar + main ===== */
#root {
    height: 1fr;
}

#sidebar {
    width: 22;
    height: 100%;
    background: #181825;
    padding: 0 1;
}

#main {
    width: 1fr;
    height: 100%;
}

/* ===== MAIN AREA ===== */
#main-header {
    height: 1;
    color: #cdd6f4;
    padding: 0 1;
}

#main-activity {
    height: 10;
    border: none;
}

#main-log {
    height: 1fr;
    border: none;
}

/* ===== SIDEBAR ===== */
#side-list {
    height: 1fr;
    color: #cdd6f4;
}

#side-stats {
    color: #a6adc8;
    padding: 0;
}

#side-rates {
    color: #cdd6f4;
    padding: 0;
}

/* ===== DATA TABLES ===== */
DataTable {
    border: none;
    color: #cdd6f4;
}

DataTable > .datatable--header {
    text-style: bold;
    color: #a6adc8;
}

DataTable > .datatable--cursor {
    background: #45475a;
    color: #cdd6f4;
}

/* ===== RICH LOG ===== */
RichLog {
    border: none;
    color: #cdd6f4;
}

/* ===== MODAL SCREENS ===== */
ModalScreen {
    align: center middle;
}

#settings-dialog, #wizard-dialog,
#intervene-dialog, #editor-dialog {
    width: 50;
    height: auto;
    border: solid #89b4fa;
    padding: 0 1;
    background: #1e1e2e;
}

/* ===== ACTIVITY DETAIL ===== */
#activity-detail-dialog {
    width: 60;
    height: auto;
    border: solid #89b4fa;
    padding: 0 1;
    background: #1e1e2e;
}

/* ===== GENERIC UTILITY ===== */
.bold { text-style: bold; }
.dim { color: #6c7086; }
.green { color: #a6e3a1; }
.red { color: #f38ba8; }
.yellow { color: #f9e2af; }
.magenta { color: #cba6f7; }
